<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Quantix.Generator.Tests — drives the generator over in-memory compilations and asserts the
    emitted source and the QTX diagnostics. Quantix.Generator is referenced as a normal assembly
    (not an analyzer) so the tests can instantiate and run it directly.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Quantix.Abstractions/Quantix.Abstractions.csproj" />
    <ProjectReference Include="../../src/Quantix.Generator/Quantix.Generator.csproj" />
  </ItemGroup>

</Project>
