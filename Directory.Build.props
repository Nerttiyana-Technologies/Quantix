<Project>

  <!--
    Quantix — shared MSBuild configuration.

    Applies to every project in the solution. Project-specific settings
    (target frameworks, packaging, IsAotCompatible, IsRoslynComponent) live
    in the individual .csproj files, layer by layer per docs/IMPLEMENTATION_PLAN.md.
  -->

  <PropertyGroup Label="Language">
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <!--
      NU1900 ("could not fetch package vulnerability data") is environmental — it fires when
      the NuGet audit cannot reach the feed (offline or air-gapped build). It is not a
      code-quality signal, so it must not break the build. Genuine vulnerability findings
      (NU1901-NU1904) are not exempted and still fail the build.
    -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900</WarningsNotAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="Build">
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <UseArtifactsOutput>true</UseArtifactsOutput>
  </PropertyGroup>

  <PropertyGroup Label="Defaults">
    <!-- Single-package model (D6): only src/Quantix opts back in to packing. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup Label="Metadata">
    <Authors>Suresh Subramanian</Authors>
    <Product>Quantix</Product>
    <Copyright>Copyright (c) Suresh Subramanian</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <PropertyGroup Label="Versioning">
    <!--
      MinVer derives the version from the nearest 'v*' git tag (e.g. tag v1.0.0 -> 1.0.0).
      An untagged build becomes a 0.0.0-alpha pre-release. CI must check out with full
      history and tags (fetch-depth: 0) for this to resolve correctly.
    -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
  </PropertyGroup>

  <ItemGroup Label="Versioning">
    <PackageReference Include="MinVer" PrivateAssets="all" />
  </ItemGroup>

</Project>
