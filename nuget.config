<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Quantix restores solely from nuget.org.

    <clear /> drops any package sources inherited from machine- or user-level
    NuGet config (for example a Telerik feed), so restore is deterministic for
    every contributor and for CI. With a single source, central package
    management no longer needs package source mapping (resolves NU1507).
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

</configuration>
